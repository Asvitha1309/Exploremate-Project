# ExploreMate Environment Variables
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000

# Google Gemini API Key (from Google AI Studio - free tier)
# Needed for the AI Travel Chatbot endpoint POST /api/chat
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google Places API Key (Optional)
# If provided, enables live photo queries via Google Places Photos API
GOOGLE_PLACES_API_KEY=
